    specs.appende(kwspec_ctx("iuncta", token.token_kind_iuncta(), TYPE_NAME_OR_CONSTRUCTOR, KeywordCategory.Declaration))
    specs.appende(kwspec_ctx("implendum", token.token_kind_implendum(), DECLARATION_INTRODUCER, KeywordCategory.Declaration))
