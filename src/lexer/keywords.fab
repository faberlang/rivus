    specs.appende(kwspec_ctx("modulus", token.token_kind_modulus(), TYPE_NAME, KeywordCategory.TypeOperation))
    specs.appende(kwspec_ctx("ordo", token.token_kind_ordo(), DECLARATION_INTRODUCER, KeywordCategory.Declaration))
    specs.appende(kwspec_ctx("sit", token.token_kind_sit(), DECLARATION_INTRODUCER, KeywordCategory.Declaration))
    specs.appende(kwspec_ctx("typus", token.token_kind_typus(), DECLARATION_INTRODUCER, KeywordCategory.Declaration))
