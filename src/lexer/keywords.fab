    specs.appende(kwspec_scope("futura", token.token_kind_futura(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("imperium", token.token_kind_imperium(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_ctx("longum", token.token_kind_longum(), ANNOTATION_MODIFIER, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("operandus", token.token_kind_operandus(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("optio", token.token_kind_optio(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_ctx("ubique", token.token_kind_ubique(), ANNOTATION_MODIFIER, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("nucleum", token.token_kind_nucleum(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("machina", token.token_kind_machina(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("vertex", token.token_kind_vertex(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("fragment", token.token_kind_fragment(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("nondum", token.token_kind_nondum(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("verte", token.token_kind_verte(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_ctx("nomen", token.token_kind_nomen(), ANNOTATION_MODIFIER, KeywordCategory.CategoryAnnotation))
    specs.appende(kwspec_scope("radix", token.token_kind_radix(), KeywordScope.Annotation, KeywordCategory.CategoryAnnotation))
    return specs
}

# ---------------------------------------------------------------------------
# Registry lookups.
# ---------------------------------------------------------------------------

# Return keyword group declarations in deterministic order.
fn keyword_group_specs() → list<KeywordGroupSpec> {
    return KEYWORD_GROUP_SPECS
}

# Look up registry metadata for an exact source spelling.
fn lookup_keyword_spec(string text) → KeywordSpec ∪ null {
    for from keyword_specs() const spec {
        if spec.text ≡ text {
            return spec
        }
    }
    return null
}

# Return the live token kind for an exact normal-mode keyword spelling.
# Metadata-only rows (tokenless) stay out of the scanner even though tools
# may still explain them through the registry.
fn keyword_token_kind(string text) → token.TokenKind ∪ null {
    const KeywordSpec ∪ null spec ← lookup_keyword_spec(text)
    if spec not is null {
        const KeywordSpec spec2 ← spec
        return spec2.token_kind
    }
    return null
}

# Return the canonical spelling for a keyword token kind, if any.
fn keyword_spelling_for_token(token.TokenKind kind) → string ∪ null {
    const KeywordSpec ∪ null spec ← keyword_spec_for_token(kind)
    if spec not is null {
        const KeywordSpec spec2 ← spec
        return spec2.text
    }
    return null
}

# Whether this keyword row has an identity token.
# Every registered keyword has one; the lexer never emits keyword tokens, so
# this is identity presence, not lexer emission.
fn keyword_spec_currently_lexes(KeywordSpec spec) → bool {
    return spec.token_kind not is null
}

# Return whether `owner` may reinterpret a keyword token as an identifier.
fn keyword_allowed_as_ident(KeywordOwner owner, token.TokenKind kind) → string ∪ null {
    const KeywordSpec ∪ null spec ← keyword_spec_for_token(kind)
    if spec not is null {
        const KeywordSpec spec2 ← spec
        if keyword_owner_allows_spec(owner, spec2) {
            return spec2.text
        }
    }
    return null
}

# Registry row whose identity token matches `kind`.
fn keyword_spec_for_token(token.TokenKind kind) → KeywordSpec ∪ null {
    for from keyword_specs() const spec {
        const token.TokenKind ∪ null tk ← spec.token_kind
        if tk not is null {
            const token.TokenKind tk2 ← tk
            if tk2 ≡ kind {
                return spec
            }
        }
    }
    return null
}

# Whether a spec's scope accepts `owner` as an identifier-like position.
fn keyword_owner_allows_spec(KeywordOwner owner, KeywordSpec spec) → bool {
    match spec.scope {
        case KeywordScope.Contextual const owners {
            return owners.continet(owner)
        }
        case KeywordScope.TestOwned {
            return keyword_owner_is_identifier_like(owner)
        }
        case KeywordScope.Alias const canonical {
            return keyword_owner_is_identifier_like(owner)
        }
        case KeywordScope.Global {
            if not keyword_owner_is_identifier_like(owner) {
                return false
            }
            return GLOBAL_PARAMETER_OR_MEMBER.continet(spec.text)
        }
        case KeywordScope.Annotation {
            return owner ≡ KeywordOwner.AnnotationName
        }
    }
}

# Whether the owner is a position that may carry identifier-like spellings.
fn keyword_owner_is_identifier_like(KeywordOwner owner) → bool {
    match owner {
        case KeywordOwner.DeclarationName { return true }
        case KeywordOwner.ParameterName { return true }
        case KeywordOwner.MemberIdentifier { return true }
        case _ { return false }
    }
}

# Validate that static keyword groups reference live keyword rows.
fn validate_keyword_groups() → list<KeywordGroupValidationError> {
    var list<KeywordGroupValidationError> errors ← []
    for from KEYWORD_GROUP_SPECS const group {
        if group.members.longitudo() ≡ 0 {
            errors.appende(variant EmptyGroup { group = group.id } ∷ KeywordGroupValidationError)
            continue
        }
        for from group.members const member {
            if lookup_keyword_spec(member) is null {
                errors.appende(variant UnknownMember { group = group.id, key = member } ∷ KeywordGroupValidationError)
            }
        }
    }
    return errors
}

# Globally reserved spellings that may still name parameters or members.
const list<string> GLOBAL_PARAMETER_OR_MEMBER ← ["cape", "inter", "scribe", "incipiet", "ex", "ad"]
