# rivus/src/lexer/keywords.fab — keyword spelling registry for lexer and
# language-tool policy (port of radix-lexer/src/keywords.rs).
#
# The registry is the single source of truth for keyword identity. Every
# keyword resolves to a locale-independent identity token via
# `lookup_keyword_spec`; the parser claims keywords by that identity in its
# grammar slots.
#
# WHY THIS EXISTS
# Keywords are locale items: a reader pack re-spells the same identity for
# each language, and the lexer never emits keyword tokens — every keyword
# lexes as an identifier with its latin key recorded, so the parser resolves
# identity through this registry in any locale.
#
# INVARIANTS
# - `token_kind` is the keyword's locale-independent identity token. It is
#   never emitted by the lexer; the parser references keywords by identity.
# - `scope` records where a keyword is claimed. `Global` does not exist —
#   no keyword is reserved everywhere (the variant stays for API parity).
# - `Alias` entries name their canonical spelling.
# - Keyword groups declare source-surface completeness constraints for
#   reader packs; missing one member of a group is a validation error.
#
# en surface (L3): identifiers port 1:1 from radix. Rust enums → unions,
# structs → classes, `&'static [KeywordOwner]` → const lists. The
# `OnceLock`/discriminant maps in radix are lookup optimizations — the
# ~180-row registry is scanned linearly (goal-doc port note).
#
# Variant-name renames (module-flat union variants — radix has no such
# constraint): KeywordCategory::Annotation/Literal/Operator/ControlFlow are
# renamed CategoryAnnotation/CategoryLiteral/CategoryOperator/
# CategoryControlFlow to avoid collisions with KeywordScope.Annotation and
# KeywordOwner.Literal/Operator/ControlFlow.

import from "§src/lexer/token" private token

# ---------------------------------------------------------------------------
# KeywordOwner — parser or tooling surface that owns a contextual spelling.
# ---------------------------------------------------------------------------

union KeywordOwner {
    EntryModifier,
    FunctionModifier,
    GenusHeader,
    GenusMember,
    RestPattern,
    SpreadExpression,
    AnnotationName,
    AnnotationModifier,
    MemberIdentifier,
    DeclarationName,
    ParameterName,
    ImportVisibility,
    TypeParameter,
    ParameterMode,
    AliasMarker,
    IterationMode,
    PredicateOperator,
    CallablePosture,
    ControlOperation,
    TypeName,
    Constructor,
    ScribeStatement,
    BuiltinCall,
    Literal,
    Operator,
    DeclarationIntroducer,
    ControlFlow,
    ExpressionIntroducer,
    RangeOperator,
    StatementIntroducer,
    DeclarationMarker,
    RouteExpression
}

# ---------------------------------------------------------------------------
# KeywordCategory — taxonomy bucket used by diagnostics and tooling.
# ---------------------------------------------------------------------------

union KeywordCategory {
    Declaration,
    Modifier,
    CategoryControlFlow,
    Transfer,
    ErrorHandling,
    Async,
    CategoryLiteral,
    CategoryOperator,
    Object,
    TypeOperation,
    Output,
    EntryPoint,
    Resource,
    Endpoint,
    Misc,
    Range,
    Testing,
    Nullability,
    CategoryAnnotation
}

# ---------------------------------------------------------------------------
# KeywordScope — where a keyword spelling is valid or intended to be owned.
# ---------------------------------------------------------------------------

union KeywordScope {


    Global,

    Contextual { list<KeywordOwner> owners },

    Annotation,

    TestOwned,

    Alias { string canonical }
}

# ---------------------------------------------------------------------------
# KeywordSpec / KeywordGroupSpec — registry row and group declarations.
# ---------------------------------------------------------------------------

# Registry row for one known keyword or keyword-like spelling.
class KeywordSpec {
    string text
    token.TokenKind ∪ null token_kind
    KeywordScope scope
    KeywordCategory category
}

# Keyword families that must be localized together in a complete reader pack.
class KeywordGroupSpec {
    string id
    list<string> members
}

# Validation issue for the static keyword group declarations.
union KeywordGroupValidationError {
    EmptyGroup { string group },
    UnknownMember { string group, string key }
}

# ---------------------------------------------------------------------------
# Owner lists (radix `&[KeywordOwner]` consts — declared here so the registry
# rows stay compact).
# ---------------------------------------------------------------------------

const list<KeywordOwner> GENUS_HEADER ← [KeywordOwner.GenusHeader]
const list<KeywordOwner> GENUS_MEMBER ← [KeywordOwner.GenusMember]
const list<KeywordOwner> IMPORT_VISIBILITY_ANNOTATION_OR_MEMBER ← [
    KeywordOwner.ImportVisibility,
    KeywordOwner.AnnotationName,
    KeywordOwner.MemberIdentifier
]
const list<KeywordOwner> ENTRY_FUNCTION_OR_PARAM_OR_MEMBER ← [
    KeywordOwner.EntryModifier,
    KeywordOwner.FunctionModifier,
    KeywordOwner.DeclarationName,
    KeywordOwner.ParameterName,
    KeywordOwner.MemberIdentifier
]
const list<KeywordOwner> ANNOTATION_NAME ← [KeywordOwner.AnnotationName]
const list<KeywordOwner> TYPE_PARAMETER ← [KeywordOwner.TypeParameter]
const list<KeywordOwner> GENERIC_PARAMETER ← [KeywordOwner.TypeParameter]
const list<KeywordOwner> REST_PATTERN ← [
    KeywordOwner.RestPattern,
    KeywordOwner.AnnotationModifier
]
const list<KeywordOwner> FUNCTION_MODIFIER ← [KeywordOwner.FunctionModifier]
const list<KeywordOwner> ENTRY_OR_FUNCTION_MODIFIER ← [
    KeywordOwner.EntryModifier,
    KeywordOwner.FunctionModifier
]
const list<KeywordOwner> PARAMETER_MODE ← [
    KeywordOwner.ParameterMode,
    KeywordOwner.IterationMode
]
const list<KeywordOwner> ALIAS_MARKER ← [KeywordOwner.AliasMarker]
const list<KeywordOwner> ITERATION_MODE ← [KeywordOwner.IterationMode]
const list<KeywordOwner> SPREAD_EXPRESSION ← [KeywordOwner.SpreadExpression]
const list<KeywordOwner> PREDICATE_OPERATOR ← [KeywordOwner.PredicateOperator]
const list<KeywordOwner> PREDICATE_OR_MEMBER ← [
    KeywordOwner.PredicateOperator,
    KeywordOwner.MemberIdentifier
]
const list<KeywordOwner> CALLABLE_POSTURE ← [KeywordOwner.CallablePosture]
const list<KeywordOwner> CONTROL_OPERATION ← [KeywordOwner.ControlOperation]
# Batch A type-name slots: `modulus` claims the type-name position; `iuncta`
# claims both the type-name and the constructor-expression position.
const list<KeywordOwner> TYPE_NAME ← [KeywordOwner.TypeName]
const list<KeywordOwner> TYPE_NAME_OR_CONSTRUCTOR ← [
    KeywordOwner.TypeName,
    KeywordOwner.Constructor
]
# Batch B builtin slots: `nota`/`mone`/`vide` are claimed in the statement-
# initial scribe slot; `lege`/`lineam`/`scriptum` in the expression-primary
# builtin-call slot.
const list<KeywordOwner> SCRIBE_STATEMENT ← [KeywordOwner.ScribeStatement]
const list<KeywordOwner> BUILTIN_CALL ← [KeywordOwner.BuiltinCall]
# Batch C literal slot: `verum`/`falsum`/`nihil` are claimed in expression
# and pattern positions as literal values.
const list<KeywordOwner> LITERAL ← [KeywordOwner.Literal]
const list<KeywordOwner> OPERATOR ← [KeywordOwner.Operator]
const list<KeywordOwner> DECLARATION_INTRODUCER ← [KeywordOwner.DeclarationIntroducer]
const list<KeywordOwner> CONTROL_FLOW ← [KeywordOwner.ControlFlow]
const list<KeywordOwner> EXPRESSION_INTRODUCER ← [KeywordOwner.ExpressionIntroducer]
const list<KeywordOwner> RANGE_OPERATOR ← [KeywordOwner.RangeOperator]
const list<KeywordOwner> STATEMENT_INTRODUCER ← [KeywordOwner.StatementIntroducer]
const list<KeywordOwner> DECLARATION_MARKER ← [KeywordOwner.DeclarationMarker]
const list<KeywordOwner> ROUTE_EXPRESSION ← [KeywordOwner.RouteExpression]
const list<KeywordOwner> ANNOTATION_MODIFIER ← [KeywordOwner.AnnotationModifier]
# WHY: test annotation spellings are valid after `@` and as import/decl names
# (`privata solum`), but not as bare type or binding identifiers
# (`fixum solum x`).
const list<KeywordOwner> TEST_ANNOTATION_NAME ← [
    KeywordOwner.AnnotationName,
    KeywordOwner.DeclarationName,
    KeywordOwner.ParameterName,
    KeywordOwner.MemberIdentifier
]

# ---------------------------------------------------------------------------
# Group member lists and group declarations.
# ---------------------------------------------------------------------------

const list<string> CONDITIONAL_GROUP ← ["si", "sin", "secus"]
const list<string> CHOICE_GROUP ← ["elige", "casu", "ceterum"]
const list<string> PATTERN_CHOICE_GROUP ← ["discerne", "casu", "ceterum"]
const list<string> TRY_RECOVERY_GROUP ← ["cape"]
const list<string> LOOP_GROUP ← ["dum", "fac", "itera", "perge", "rumpe"]

# Complete keyword-group declarations for static Latin source-surface data.
const list<KeywordGroupSpec> KEYWORD_GROUP_SPECS ← [
    KeywordGroupSpec { id = "conditional", members = CONDITIONAL_GROUP },
    KeywordGroupSpec { id = "choice", members = CHOICE_GROUP },
    KeywordGroupSpec { id = "pattern_choice", members = PATTERN_CHOICE_GROUP },
    KeywordGroupSpec { id = "try_recovery", members = TRY_RECOVERY_GROUP },
    KeywordGroupSpec { id = "loop", members = LOOP_GROUP }
]

# ---------------------------------------------------------------------------
# KEYWORD_SPECS — complete registry of current, contextual, alias, and
# annotation spellings (135 rows, radix declaration order).
# ---------------------------------------------------------------------------

# Return the keyword spelling registry in deterministic declaration order.
# WHY a function: qualified references to the imported TokenKind variants do
# not type in const-initializer context (the faber checker rejects
# cross-module variant values in const position), so the rows are built in a
# plain fn body and returned fresh on each call. A module-level lazy
# singleton is a future optimization (see residuals).
#
# Compact row constructors. Two entry points keep every call to at most one
# inline variant construction plus one inline unit reference (the faber
# checker rejects calls with multiple inline union-typed arguments — SEM010).
fn kwspec_ctx(string text, token.TokenKind kind, list<KeywordOwner> owners, KeywordCategory category) → KeywordSpec {
    return KeywordSpec {
        text = text,
        token_kind = kind,
        scope = variant Contextual { owners = owners } ∷ KeywordScope,
        category = category
    }
}

# Row constructor for unit-scope rows (TestOwned / Annotation / Alias).
fn kwspec_scope(string text, token.TokenKind kind, KeywordScope scope, KeywordCategory category) → KeywordSpec {
    return KeywordSpec {
        text = text,
        token_kind = kind,
        scope = scope,
        category = category
    }
}

# The tokenless `vacua` row: `token_kind` is null, so the non-nullable row
# constructors cannot build it — the full record form is used instead.
fn vacua_spec() → KeywordSpec {
    return KeywordSpec {
        text = "vacua",
        token_kind = null,
        scope = variant Contextual { owners = EXPRESSION_INTRODUCER } ∷ KeywordScope,
        category = KeywordCategory.CategoryLiteral
    }
}

fn keyword_specs() → list<KeywordSpec> {
    var list<KeywordSpec> specs ← []
    specs.appende(kwspec_ctx("discretio", token.token_kind_discretio(), DECLARATION_INTRODUCER, KeywordCategory.Declaration))
    specs.appende(kwspec_ctx("fixum", token.token_kind_fixum(), DECLARATION_INTRODUCER, KeywordCategory.Declaration))
    specs.appende(kwspec_ctx("functio", token.token_kind_functio(), DECLARATION_INTRODUCER, KeywordCategory.Declaration))
