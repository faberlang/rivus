    specs.appende(kwspec_ctx("abstractus", token.token_kind_abstractus(), GENUS_HEADER, KeywordCategory.Modifier))
    specs.appende(kwspec_ctx("ceteri", token.token_kind_ceteri(), REST_PATTERN, KeywordCategory.Modifier))
    specs.appende(kwspec_ctx("curata", token.token_kind_curata(), FUNCTION_MODIFIER, KeywordCategory.Modifier))
    specs.appende(kwspec_ctx("errata", token.token_kind_errata(), FUNCTION_MODIFIER, KeywordCategory.Modifier))
    specs.appende(kwspec_ctx("exitus", token.token_kind_exitus(), ENTRY_OR_FUNCTION_MODIFIER, KeywordCategory.Modifier))
    specs.appende(kwspec_ctx("generis", token.token_kind_generis(), GENUS_MEMBER, KeywordCategory.Modifier))
