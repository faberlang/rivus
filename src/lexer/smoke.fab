# rivus/src/lexer/smoke.fab — proba smoke tests (mirrors the spirit of
# radix-lexer scan_test.rs / token_test.rs).
#
# en surface: `test` = proba, `assert` = adfirma. Tests run via
# `faber test` (proba cases on the MIR stepper, no Cargo). Written but not
# run — `faber test` is itself under-tested, so running is deferred (same as
# migrate-diagnostics).

import from "§src/lexer/token" private token
import from "§src/lexer/interner" private interner
import from "§src/lexer/scan" private scan

test "interner_round_trip" {
    var interner.Interner in ← interner.interner_new()
    const token.Symbol a ← interner.interner_intern(in, "alpha")
    const token.Symbol b ← interner.interner_intern(in, "alpha")
    const token.Symbol c ← interner.interner_intern_raw(in, "alpha")
    # The same spelling re-interns to the same symbol; raw and normalized
    # paths coincide on the ASCII surface.
    assert a.id ≡ b.id
    assert c.id ≡ a.id
    assert interner.interner_resolve(in, a) ≡ "alpha"
    # One unique string in the table.
    assert interner.interner_strings(in).longitudo() ≡ 1
}

test "lex_trivial_program" {
    const scan.LexResult result ← scan.lex("nota \"salve\"")
    # No lexical diagnostics on a trivial program.
    assert scan.lex_result_success(result)
    # "nota" is a keyword: it lexes as an identifier with its latin key
    # recorded for the parser (Ident, String, Newline, Eof — terminal Eof is
    # always present).
    assert result.reader_keyword_latin_keys.habet("nota")
    assert result.tokens.longitudo() ≥ 4
}
