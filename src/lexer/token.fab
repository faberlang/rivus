# rivus/src/lexer/token.fab — token and symbol data contracts (port of
# radix-lexer/src/token.rs).
#
# Owns the Token and Symbol types plus the complete TokenKind vocabulary.
# Scanner policy lives in scan.fab; keyword taxonomy and alias metadata live
# in keywords.fab; this module keeps the transport representation explicit
# and cheap to copy.
#
# INVARIANTS
# - Spans are offsets into the original UTF-8 source, not offsets into
#   normalized strings. For the Latin corpus scalar count == byte offset, so
#   the scalar-based cursor positions double as byte spans (L3).
# - Symbol values are indexes into the Interner from the same lexer run.
# - Literal tokens carry parsed numeric values; source spelling is recovered
#   through spans when diagnostics or formatters need it.
#
# en surface (L3): identifiers port 1:1 from radix. Rust enums → unions,
# structs → classes, tuples → payload fields. `Integer`/`Float` payloads are
# `int`/`float` (the en surface names for numerus/fractus — the goal doc's
# "num" is not an en-surface type).
#
# Variant discrimination lives here (same module): the faber checker rejects
# match arms over imported union variants (SEM001, defect-sprint row 1), so
# consumers call the predicate functions below instead of matching
# token.TokenKind directly. Payload-variant construction also stays here
# (PARSE030 rejects qualified `variant pkg.Name { ... }` construction).

import from "§src/diagnostics/span" private span

# ---------------------------------------------------------------------------
# Symbol — interned string handle local to one lexer run.
# ---------------------------------------------------------------------------

# Interned string handle. Symbols are cheap to compare but not globally
# meaningful: resolve them only with the Interner that produced the token
# stream containing the symbol.
class Symbol {
    int id
}

# Create a symbol handle for an interner string-table index.
fn symbol_new(int id) → Symbol {
    return Symbol { id = id }
}

# ---------------------------------------------------------------------------
# Token — one lexical item paired with its original source location.
# ---------------------------------------------------------------------------

# Tokens never borrow source text directly. Payload text moves through
# Symbol handles; exact spelling remains available through the span and the
# original source buffer.
class Token {
    TokenKind kind
    span.Span span
}

# Classify a token payload and the source offset range it consumed.
fn token_new(TokenKind kind, span.Span span) → Token {
    return Token { kind = kind, span = span }
}

# ---------------------------------------------------------------------------
# TokenKind — complete token vocabulary visible to the parser.
# ---------------------------------------------------------------------------

# This union is deliberately broad: it includes current source tokens,
# metadata tokens, error/recovery sentinels, and a small number of reserved
# internal variants. Spelling policy lives in scanner/keyword tables; this
# type is the parser-facing vocabulary.
union TokenKind {

    Ident { Symbol sym },
    Underscore { Symbol sym },
    Integer { int value },
    Float { float value },
    String { Symbol sym },
    AsciiString { Symbol sym },
    BacktickString { Symbol sym },
    OctetiString { Symbol sym },


    Discretio,
    Fixum,
    Functio,
    Genus,
    Iuncta,
    Implendum,
    Importa,
    Magnitudo,
    Modulus,
    Ordo,
    Proba,
    Probandum,
    Sit,
    Typus,
    Varia,

    Abstractus,
    Ceteri,
    Curata,
    Errata,
    Exitus,
    Generis,
    Iacit,
    Immutata,
    Nexum,
    Optiones,
    Prae,
    Privata,
    Protecta,
    Publica,

    Casu,
    Ceterum,
    Custodi,
    Discerne,
    Dum,
    Elige,
    Ergo,
    Fac,
    Itera,
    Secus,
    Si,
    Sic,
    Sin,

    Perge,
    Redde,
    Rumpe,
    Tacet,

    Adfirma,
    Cape,
    Iace,
    Mori,

    Cede,
    Clausura,
    Cursor,
    Futura,
    Fiet,
    Fiunt,
    Fient,
    Figendum,
    Variandum,
    Reddet,
    Tacebit,

    Brevis,
    Cli,
    Descriptio,
    Fragment,
    Imperium,
    Longum,
    Machina,
    Nomen,
    Nondum,
    Nucleum,
    Operandus,
    Optio,
    Radix,
    Ubique,
    Vertex,

    Falsum,
    Nihil,
    Verum,

    Aut,
    Est,
    Et,
    Non,
    Vel,

    Ego,
    Finge,
    Implet,
    Sub,

    Conversio,
    Verte,

    Mone,
    Nota,
    Scribe,
    Vide,

    Ad,
    Argumenta,
    Cura,
    Incipiet,
    Incipit,
    Meus,
    Tuus,

    De,
    Ex,
    In,
    Lege,
    Lineam,
    Omnia,
    Praefixum,
    Scriptum,
    Sparge,
    Ut,

    Ab,
    Ante,
    Inter,
    Intra,
    Per,
    Usque,

    Fragilis,
    Futurum,
    Metior,
    Omitte,
    Postpara,
    Postparabit,
    Praepara,
    Praeparabit,
    Repete,
    Requirit,
    Solum,
    SolumIn,
    Tag,
    Temporis,

    Negativum,
    Nonnihil,
    Nonnulla,
    Nulla,
    Positivum,

    Sponte,


    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Colon,
    Semicolon,
    Dot,
    Arrow,
    ExitArrow,
    Cup,
    At,


    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    BitwiseAnd,
    BitwiseOr,
    BitwiseXor,
    BitwiseNot,
    BitwiseShl,
    BitwiseShr,
    Bang,
    Question,


    Eq,
    Assign,
    ConversioAssign,
    EqEq,
    EqEqEq,
    ApproxEq,
    ApproxNotEq,
    BangEq,
    BangEqEq,
    Lt,
    Gt,
    LtAscii,
    GtAscii,
    LtEq,
    GtEq,


    PostInc,
    PostDec,


    QuestionDot,
    QuestionBracket,
    QuestionParen,
    BangDot,
    BangBracket,
    BangParen,


    DotDot,
    Ellipsis,


    Therefore,


    LineComment { Symbol sym },
    Newline,


    Eof,
    Error
}

# ---------------------------------------------------------------------------
# Payload-variant constructors (same-module construction — PARSE030 rejects
# qualified variant construction through an import alias).
# ---------------------------------------------------------------------------

fn token_kind_ident(Symbol sym) → TokenKind {
    return variant Ident { sym = sym } ∷ TokenKind
}

fn token_kind_underscore(Symbol sym) → TokenKind {
    return variant Underscore { sym = sym } ∷ TokenKind
}

fn token_kind_integer(int value) → TokenKind {
    return variant Integer { value = value } ∷ TokenKind
}

fn token_kind_float(float value) → TokenKind {
    return variant Float { value = value } ∷ TokenKind
}

fn token_kind_string(Symbol sym) → TokenKind {
    return variant String { sym = sym } ∷ TokenKind
}

fn token_kind_ascii_string(Symbol sym) → TokenKind {
    return variant AsciiString { sym = sym } ∷ TokenKind
}

fn token_kind_backtick_string(Symbol sym) → TokenKind {
    return variant BacktickString { sym = sym } ∷ TokenKind
}

fn token_kind_octeti_string(Symbol sym) → TokenKind {
    return variant OctetiString { sym = sym } ∷ TokenKind
}

fn token_kind_line_comment(Symbol sym) → TokenKind {
    return variant LineComment { sym = sym } ∷ TokenKind
}



# ---------------------------------------------------------------------------
# Unit-variant constructors.
# WHY: cross-module references to imported union variants do not typecheck
# in live code in the current faber toolchain (the checker resolves the
# member path but cannot unify it with the union type — SEM010). Same-module
# construction works, so every unit variant gets a constructor here and
# consumers (scan.fab, keywords.fab) build token kinds by calling across the
# module boundary instead of referencing variants.

fn token_kind_discretio() → TokenKind {
    return TokenKind.Discretio
}

fn token_kind_fixum() → TokenKind {
    return TokenKind.Fixum
