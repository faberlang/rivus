# Whether this token carries source comment text.
# Parsers may skip comments while tools such as formatters preserve them.
fn token_is_comment(TokenKind kind) → bool {
    match kind {
        case TokenKind.LineComment const sym { return true }
        case _ { return false }
    }
}

# Whether this token is leading/trailing trivia skipped during infix parsing.
fn token_is_trivia(TokenKind kind) → bool {
    match kind {
        case TokenKind.LineComment const sym { return true }
        case TokenKind.Newline { return true }
        case _ { return false }
    }
}

# Whether this token sets the "code on current line" scanner flag.
# radix scan.rs `token_counts_as_line_code`: everything except newlines and
# line comments. Kept here because the faber checker cannot match imported
# union variants (SEM001).
fn token_is_line_code(TokenKind kind) → bool {
    match kind {
        case TokenKind.Newline { return false }
        case TokenKind.LineComment const sym { return false }
        case _ { return true }
    }
}
