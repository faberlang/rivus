# ---------------------------------------------------------------------------
# Token-kind predicates — same-module discrimination for consumers.
# ---------------------------------------------------------------------------

# Whether this token kind is reserved-word syntax.
# The parser and diagnostics use this to distinguish identifier-like payloads
# from tokens that need keyword-specific messages or formatting. Keyword
# identity is the registry's `token_kind` (keywords.fab); this match mirrors
# radix token.rs `is_keyword` so consumers stay free of the registry.
fn token_is_keyword(TokenKind kind) → bool {
    match kind {
        case TokenKind.Discretio { return true }
        case TokenKind.Fixum { return true }
        case TokenKind.Functio { return true }
        case TokenKind.Genus { return true }
        case TokenKind.Iuncta { return true }
        case TokenKind.Implendum { return true }
        case TokenKind.Importa { return true }
        case TokenKind.Magnitudo { return true }
        case TokenKind.Modulus { return true }
        case TokenKind.Ordo { return true }
        case TokenKind.Proba { return true }
        case TokenKind.Probandum { return true }
        case TokenKind.Sit { return true }
        case TokenKind.Typus { return true }
        case TokenKind.Varia { return true }
        case TokenKind.Abstractus { return true }
        case TokenKind.Ceteri { return true }
        case TokenKind.Curata { return true }
        case TokenKind.Errata { return true }
        case TokenKind.Exitus { return true }
        case TokenKind.Generis { return true }
        case TokenKind.Iacit { return true }
        case TokenKind.Immutata { return true }
        case TokenKind.Nexum { return true }
        case TokenKind.Optiones { return true }
        case TokenKind.Prae { return true }
        case TokenKind.Privata { return true }
        case TokenKind.Protecta { return true }
        case TokenKind.Publica { return true }
        case TokenKind.Casu { return true }
